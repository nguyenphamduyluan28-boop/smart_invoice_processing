# Chọn AI: gemini, claude hoặc openrouter
LLM_PROVIDER=gemini

# --- Google Gemini ---
# Lấy key tại https://aistudio.google.com (nút "Get API key")
GEMINI_API_KEY=
# Để trống = dùng model mặc định. Danh sách: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Tuỳ chọn: model dùng thay khi model chính quá tải/hết hạn mức. Ghi được nhiều model, cách nhau dấu phẩy
GEMINI_MODEL_DU_PHONG=
# Mức "suy nghĩ" của Gemini 3.x: low (nhanh, mặc định) / medium / high (chậm hơn, có thể chính xác hơn)
GEMINI_THINKING=low
# Mỗi lần gọi AI chờ tối đa bao nhiêu giây
GEMINI_TIMEOUT_GIAY=90

# --- Anthropic Claude ---
# Lấy key tại https://console.anthropic.com (mục API Keys)
ANTHROPIC_API_KEY=
# Để trống = dùng model mặc định. Danh sách: https://docs.claude.com/en/docs/about-claude/models
LLM_MODEL=

# --- OpenRouter (nhiều model, có model miễn phí đuôi ":free") ---
# Lấy key tại https://openrouter.ai (ảnh đại diện > Keys). Tìm model: python tools/kiem_tra_openrouter.py
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODEL_DU_PHONG=
